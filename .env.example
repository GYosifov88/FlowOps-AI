# Copy to .env and adjust. .env is git-ignored; this file is committed.
APP_NAME=FlowOps AI
LOG_LEVEL=INFO

# REQUIRED. Shared secret n8n sends in the X-FlowOps-Token header; the app will not start
# without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWOPS_INGEST_TOKEN=

# Optional. Default: SQLite file flowops.db in the repo root (git-ignored).
# DATABASE_URL=sqlite:///D:/path/to/flowops.db
